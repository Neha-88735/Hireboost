# GEMINI_API_KEY: Required for Gemini AI API calls (Interview Host, Live Transcription, Code Evaluation).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPGRAM_API_KEY: Primary real-time & turn speech-to-text engine (Deepgram Nova-3).
# Set this in AI Studio Secrets for high-accuracy live interview transcription.
DEEPGRAM_API_KEY="MY_DEEPGRAM_API_KEY"

# Optional: OpenAI API key if you want OpenAI Whisper (`whisper-1`) as an additional fallback STT provider.
# OPENAI_API_KEY=""

# Optional: Configurable Coding Problem Time Limits (in minutes) per difficulty level
CODING_LIMIT_EASY_MIN="10"
CODING_LIMIT_MEDIUM_MIN="20"
CODING_LIMIT_HARD_MIN="30"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
